<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="정산 완료 요청 크기별 처리시간 측정">
      <stringProp name="TestPlan.comments">스레드 1개로 정산 1건, 10건, 50건 요청을 순차 실행한다. 동시성 또는 부하 테스트가 아니다.</stringProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>

    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="정산 완료 순차 측정 Thread Group">
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopControlPanel" testname="워밍업 3회와 측정 90회">
          <stringProp name="LoopController.loops">93</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="정산 완료 API 요청" enabled="true">
          <stringProp name="HTTPSampler.domain">${__P(orderHost,localhost)}</stringProp>
          <stringProp name="HTTPSampler.port">${__P(orderPort,8083)}</stringProp>
          <stringProp name="HTTPSampler.protocol">http</stringProp>
          <stringProp name="HTTPSampler.path">/api/v1/settlements/complete</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">false</boolProp>
          <stringProp name="HTTPSampler.method">PATCH</stringProp>
          <stringProp name="HTTPSampler.connect_timeout">5000</stringProp>
          <stringProp name="HTTPSampler.response_timeout">30000</stringProp>
          <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
          <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
          <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
            <collectionProp name="Arguments.arguments">
              <elementProp name="" elementType="HTTPArgument">
                <boolProp name="HTTPArgument.always_encode">false</boolProp>
                <stringProp name="Argument.value">{&quot;settlementIds&quot;:[${settlementIds}]}</stringProp>
                <stringProp name="Argument.metadata">=</stringProp>
              </elementProp>
            </collectionProp>
          </elementProp>
        </HTTPSamplerProxy>
        <hashTree>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="관리자 요청 헤더">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="Content-Type" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
              <elementProp name="X-User-Id" elementType="Header">
                <stringProp name="Header.name">X-User-Id</stringProp>
                <stringProp name="Header.value">00000000-0000-4000-8000-000000000099</stringProp>
              </elementProp>
              <elementProp name="X-User-Role" elementType="Header">
                <stringProp name="Header.name">X-User-Role</stringProp>
                <stringProp name="Header.value">ADMIN</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="요청 크기에 맞는 정산 ID 생성" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
int requestIndex = vars.getIteration() - 1
if (requestIndex &lt; 0 || requestIndex &gt;= 93) {
    throw new IllegalArgumentException('요청 반복 번호는 1부터 93까지여야 합니다.')
}
int sizeIndex = requestIndex % 3
int requestSize = [1, 10, 50][sizeIndex]
// 완료된 ID를 재사용하지 않도록 1+10+50건을 묶어 회차마다 새 ID를 배정한다.
long firstFixtureNo = requestIndex.intdiv(3) * 61L + [1, 2, 12][sizeIndex]
vars.put('scenarioType', requestIndex &lt; 3 ? 'warmup' : 'measurement')
vars.put('requestSize', requestSize.toString())
def settlementIds = (firstFixtureNo..&lt;(firstFixtureNo + requestSize)).collect {
    String.format(java.util.Locale.ROOT, '00000000-0000-4000-8000-%012d', it)
}
vars.putObject('expectedSettlementIds', settlementIds)
vars.put('settlementIds', settlementIds.collect { '&quot;' + it + '&quot;' }.join(','))
</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="응답과 항목별 완료 결과 확인" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
try {
    def response = new groovy.json.JsonSlurper().parseText(prev.getResponseDataAsString())
    int expectedCount = vars.get('requestSize').toInteger()
    def results = response.data
    def expectedIds = vars.getObject('expectedSettlementIds')
    boolean valid = prev.getResponseCode() == '200'
            &amp;&amp; response.code == 'OK'
            &amp;&amp; results instanceof List
            &amp;&amp; results.size() == expectedCount
    if (valid) {
        def actualIds = results.collect { it.settlementId }
        valid = actualIds == expectedIds
        valid = valid &amp;&amp; results.every {
            it.status == 'COMPLETED' &amp;&amp; it.settledAt &amp;&amp; it.orderItemId
                    &amp;&amp; it.result == 'SUCCESS'
        }
    }
    if (!valid) {
        AssertionResult.setFailure(true)
        AssertionResult.setFailureMessage('요청 ' + expectedCount + '건 중 실패가 있거나 응답 형식이 예상과 다릅니다.')
    }
} catch (Exception e) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage('응답 JSON을 확인하지 못했습니다: ' + e.getMessage())
}
</stringProp>
          </JSR223Assertion>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="워밍업과 측정 라벨 구분" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="script">
def prefix = vars.get('scenarioType') == 'warmup' ? '워밍업' : '측정'
prev.setSampleLabel(prefix + ' - 정산 ' + vars.get('requestSize') + '건')
</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
