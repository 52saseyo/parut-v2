    {
      "type": "stat",
      "title": "처리 완료 건수",
      "description": "정상 종료한 테스트만 분리하고 실행 전후 수집값이 있는 구간에서 사용합니다. 실패/다른 실행/재시작/reset이 섞이면 적용하지 않습니다. 선택 시각 이전의 최신 표본 차이이며 실시간 운영 집계용이 아닙니다. 실행 ID는 로그 상세만 필터링합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(settlement_completion_records_completed_total{job=\"order-perf\",instance=~\"${instance:regex}\"} - settlement_completion_records_completed_total{job=\"order-perf\",instance=~\"${instance:regex}\"} offset ${__range_s}s)",
          "instant": true,
          "range": false,
          "legendFormat": "처리 완료 건수"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
