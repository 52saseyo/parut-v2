    {
      "type": "timeseries",
      "title": "Hikari Active / Idle / Pending",
      "description": "Active는 사용 중, Idle은 대기 중, Pending은 커넥션을 기다리는 요청 수입니다. 5초마다 수집해서 1초 미만 작업의 순간 값은 잡히지 않을 수 있습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{job=\"order-service\",instance=~\"${instance:regex}\"}",
          "legendFormat": "Active",
          "range": true,
          "interval": "5s"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_idle{job=\"order-service\",instance=~\"${instance:regex}\"}",
          "legendFormat": "Idle",
          "range": true,
          "interval": "5s"
        },
        {
          "refId": "C",
          "expr": "hikaricp_connections_pending{job=\"order-service\",instance=~\"${instance:regex}\"}",
          "legendFormat": "Pending",
          "range": true,
          "interval": "5s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "max",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 24
    },
    {
      "type": "timeseries",
      "title": "평균 커넥션 획득 시간",
      "description": "풀에서 커넥션을 얻는 데 걸린 평균 시간입니다. 커지면 풀이 부족하다는 신호입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(hikaricp_connections_acquire_seconds_sum{job=\"order-service\",instance=~\"${instance:regex}\"}[$__rate_interval])) / sum(rate(hikaricp_connections_acquire_seconds_count{job=\"order-service\",instance=~\"${instance:regex}\"}[$__rate_interval])) * 1000",
          "legendFormat": "연결 획득 평균",
