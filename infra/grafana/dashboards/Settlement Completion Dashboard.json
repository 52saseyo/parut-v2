          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(up{job=\"order-perf\"}, instance)",
        "query": {
          "query": "label_values(up{job=\"order-perf\"}, instance)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "order-perf:8080",
          "value": "order-perf:8080"
        }
      },
      {
        "name": "run_id",
        "label": "실행 ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [
          {
            "selected": true,
            "text": "",
            "value": ""
          }
