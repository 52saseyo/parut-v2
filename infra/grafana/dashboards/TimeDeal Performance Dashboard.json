        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(jvm_memory_used_bytes{application=~\"$application\"}, instance)",
        "includeAll": true,
        "label": "Instance",
        "name": "instance",
        "query": { "query": "label_values(jvm_memory_used_bytes{application=~\"$application\"}, instance)", "refId": "StandardVariableQuery" },
