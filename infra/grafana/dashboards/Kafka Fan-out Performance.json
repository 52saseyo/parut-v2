                        "range": true
                      }
                    },
                    "refId": "D",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "1000 * sum(rate(notification_fanout_flush_seconds_sum[$__rate_interval])) / sum(rate(notification_fanout_flush_seconds_count[$__rate_interval]))",
                        "legendFormat": "Flush",
                        "range": true
                      }
                    },
                    "refId": "E",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.2",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [
                    "mean",
