{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "kafka-fanout-performance",
    "namespace": "default"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "query": {
            "kind": "DataQuery",
            "group": "grafana",
            "version": "v0",
            "datasource": {
              "name": "-- Grafana --"
            },
            "spec": {}
          },
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "builtIn": true
        }
      }
    ],
    "cursorSync": "Crosshair",
    "editable": true,
    "elements": {
      "panel-summary": {
        "kind": "Panel",
        "spec": {
          "id": 4,
          "title": "Run Summary",
          "description": "선택한 시간 범위의 성공·실패, 생성 알림, 평균 처리시간과 범위 평균 처리율을 요약합니다.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(last_over_time(notification_fanout_total_seconds_count{result=\"success\"}[$__range]) - first_over_time(notification_fanout_total_seconds_count{result=\"success\"}[$__range])) or vector(0)",
                        "instant": true,
                        "legendFormat": "Successful Fan-outs",
                        "range": false
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(last_over_time(notification_fanout_notifications_total[$__range]) - first_over_time(notification_fanout_notifications_total[$__range])) or vector(0)",
                        "instant": true,
                        "legendFormat": "Created Notifications",
                        "range": false
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(last_over_time(notification_fanout_total_seconds_count{result=\"failure\"}[$__range]) - first_over_time(notification_fanout_total_seconds_count{result=\"failure\"}[$__range])) or vector(0)",
                        "instant": true,
                        "legendFormat": "Failures",
                        "range": false
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "1000 * sum(last_over_time(notification_fanout_total_seconds_sum{result=\"success\"}[$__range]) - first_over_time(notification_fanout_total_seconds_sum{result=\"success\"}[$__range])) / sum(last_over_time(notification_fanout_total_seconds_count{result=\"success\"}[$__range]) - first_over_time(notification_fanout_total_seconds_count{result=\"success\"}[$__range]))",
                        "instant": true,
                        "legendFormat": "Average Duration",
                        "range": false
                      }
                    },
                    "refId": "D",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(increase(notification_fanout_total_seconds_count{result=\"success\"}[$__range])) / $__range_s",
                        "instant": true,
                        "legendFormat": "Range Fan-out TPS",
                        "range": false
                      }
                    },
                    "refId": "E",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(increase(notification_fanout_notifications_total[$__range])) / $__range_s",
                        "instant": true,
                        "legendFormat": "Range Notification Rate",
                        "range": false
                      }
                    },
                    "refId": "F",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "stat",
            "version": "13.2.2",
            "spec": {
              "options": {
                "colorMode": "value",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "vertical",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "value_and_name",
                "wideLayout": true
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "short",
                  "decimals": 0,
                  "color": {
                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      }
                    ]
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Failures"
                    },
                    "properties": [
                      {
                        "id": "thresholds",
                        "value": {
                          "mode": "absolute",
                          "steps": [
                            {
                              "value": null,
                              "color": "green"
                            },
                            {
                              "value": 1,
                              "color": "red"
                            }
                          ]
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Average Duration"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "ms"
                      },
                      {
                        "id": "decimals",
                        "value": 0
                      },
                      {
                        "id": "thresholds",
                        "value": {
                          "mode": "absolute",
                          "steps": [
                            {
                              "value": null,
                              "color": "green"
                            },
                            {
                              "value": 2000,
                              "color": "orange"
                            },
                            {
                              "value": 5000,
                              "color": "red"
                            }
                          ]
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Range Fan-out TPS"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "suffix: tx/s"
                      },
                      {
                        "id": "decimals",
                        "value": 3
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Range Notification Rate"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "suffix: notifications/s"
                      },
                      {
                        "id": "decimals",
                        "value": 1
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-total": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "Fan-out Latency",
          "description": "이벤트 발생 시점에 따른 Commit 완료 기준 Fan-out 처리시간의 변화 흐름을 점과 선으로 보여주는 그래프입니다.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "1000 * sum(rate(notification_fanout_total_seconds_sum{result=\"success\"}[$__rate_interval])) / sum(rate(notification_fanout_total_seconds_count{result=\"success\"}[$__rate_interval]))",
                        "legendFormat": "Average",
                        "range": true
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(notification_fanout_total_seconds_bucket{result=\"success\"}[$__rate_interval])))",
                        "legendFormat": "P95",
                        "range": true
                      }
                    },
                    "refId": "B",
                    "hidden": false
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "prometheus",
                      "version": "v0",
                      "datasource": {
                        "name": "prometheus"
                      },
                      "spec": {
                        "editorMode": "code",
                        "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(notification_fanout_total_seconds_bucket{result=\"success\"}[$__rate_interval])))",
                        "legendFormat": "P99",
                        "range": true
                      }
                    },
                    "refId": "C",
                    "hidden": false
                  }
                }
              ],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "timeseries",
            "version": "13.2.2",
            "spec": {
              "options": {
                "legend": {
                  "calcs": [
                    "mean",
                    "max"
                  ],
                  "displayMode": "table",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "hideZeros": false,
                  "mode": "multi",
                  "sort": "desc"
                }
              },
              "fieldConfig": {
                "defaults": {
                  "unit": "ms",
                  "min": 0,
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisBorderShow": false,
                    "axisCenteredZero": false,
                    "axisColorMode": "text",
                    "axisLabel": "Duration",
                    "axisPlacement": "auto",
                    "barAlignment": 0,
                    "drawStyle": "line",
                    "fillOpacity": 8,
                    "gradientMode": "none",
                    "hideFrom": {
                      "legend": false,
                      "tooltip": false,
                      "viz": false
                    },
                    "insertNulls": false,
                    "lineInterpolation": "smooth",
                    "lineWidth": 3,
                    "pointSize": 6,
                    "scaleDistribution": {
                      "type": "linear"
                    },
                    "showPoints": "always",
                    "spanNulls": true,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    },
                    "thresholdsStyle": {
                "mode": "off"
                    }
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": null,
                        "color": "green"
                      }
                    ]
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "P95"
                    },
                    "properties": [
                      {
                        "id": "custom.drawStyle",
                        "value": "line"
                      },
                      {
                        "id": "custom.fillOpacity",
                        "value": 0
                      },
                      {
                        "id": "custom.lineWidth",
                        "value": 2
                      },
                      {
                        "id": "custom.showPoints",
                        "value": "always"
                      },
                      {
                        "id": "color",
                        "value": {
                          "mode": "fixed",
                          "fixedColor": "yellow"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "P99"
                    },
                    "properties": [
                      {
                        "id": "custom.drawStyle",
                        "value": "line"
                      },
                      {
                        "id": "custom.fillOpacity",
                        "value": 0
                      },
                      {
                        "id": "custom.lineWidth",
                        "value": 2
                      },
                      {
                        "id": "custom.showPoints",
                        "value": "always"
                      },
                      {
                        "id": "color",
                        "value": {
                          "mode": "fixed",
                          "fixedColor": "blue"
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "panel-phases": {
        "kind": "Panel",
